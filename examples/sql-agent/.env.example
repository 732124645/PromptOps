# Copy to .env (or export in your shell) before running `npm start`.

PROMPTOPS_SERVER=http://localhost:8080
PROMPTOPS_TOKEN=promptops-dev-token
PROMPTOPS_NAMESPACE=prod

# The prompt key to use for SQL generation. Create this in the Web UI first;
# see prompts/sql-generator.md for a starter template.
PROMPT_KEY=sql.generator

# Which dialect to render into the prompt. Common values: mysql, postgres, sqlite.
DIALECT=mysql

# Model provider for the Playground call. "mock" runs offline with no API key
# and is the easiest way to see the example work end-to-end. To call a real
# LLM, change to "openai" / "claude" / "ollama" / "gemini" and supply
# PROVIDER_API_KEY (and PROVIDER_BASE_URL if needed).
PROVIDER=mock
MODEL=mock-1
# PROVIDER_API_KEY=
# PROVIDER_BASE_URL=
