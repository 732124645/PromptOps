# Copy to .env (or export in your shell) before running `npm start`.

# Base URL of your running PromptOps server.
PROMPTOPS_SERVER=http://localhost:8080

# Bearer token. Defaults to the dev token; change it in production.
PROMPTOPS_TOKEN=promptops-dev-token

# Environment / namespace this app reads prompts from.
PROMPTOPS_NAMESPACE=prod

# Prompt key to watch. Create this prompt in the Web UI before running.
PROMPT_KEY=demo.greeting

# How often (ms) to re-render the prompt locally. The cache is refreshed
# automatically when the server pushes an update, so polling is only here to
# show the current value periodically in the terminal.
RENDER_INTERVAL_MS=3000
